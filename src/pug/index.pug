html(lang="en")
    head
        title Twelve Mile — Homepage
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1, shrink-to-fit=no")
        link(rel="preconnect", href="https://fonts.gstatic.com")
        link(rel="stylesheet", href="https://fonts.googleapis.com/css?family=DM+Sans:400,500,600,700,800,900|Syne:400,500,600,700,800,900&subset=latin")
        link(rel="stylesheet", href="css/tailwind/tailwind.min.css")
        link(rel="icon", type="image/png", sizes="32x32", href="shuffle-for-tailwind.png")
    body(class="antialiased font-body bg-body text-body bg-zinc-50 text-zinc-950 selection:bg-zinc-900 selection:text-zinc-50")
        div(class="")
            nav(class="w-full flex justify-between items-center py-6 px-6 md:px-12 border-b border-zinc-200 bg-zinc-50 z-50 relative")
                div(class="font-heading text-xl font-bold tracking-tighter uppercase") Twelve Mile Capital
                div(class="hidden md:flex gap-8 text-sm font-medium tracking-wide uppercase")
                    a(href="#", class="hover:text-zinc-500 transition-colors") Home
                    |           
                    a(href="#", class="hover:text-zinc-500 transition-colors") Contact
                button(class="md:hidden flex items-center justify-center p-2")
                    svg(width="24", height="24", viewbox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                        path(d="M3 12h18M3 6h18M3 18h18", stroke-linecap="square")
            section(class="relative w-full pt-16 pb-32 px-6 md:px-12 bg-zinc-50 overflow-hidden")
                div(class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 lg:gap-8 items-center")
                    div(class="lg:col-span-7 flex flex-col z-10")
                        h1(class="font-heading text-5xl sm:text-6xl md:text-8xl lg:text-[7rem] font-extrabold leading-[0.85] tracking-tighter text-zinc-950 uppercase")
                            span(class="block") FUNDING
                            |               
                            span(class="block") Teams
                            |               
                            span(class="block text-zinc-400 italic font-normal") Shaping
                            |               
                            span(class="block") Future
                            |               
                            span(class="block") Tech.
                        div(class="mt-16 flex items-center gap-6")
                            div(class="h-px w-24 bg-zinc-950")
                            a(href="#subscribe", class="text-zinc-600 font-bold tracking-widest uppercase text-xs hover:text-zinc-950 transition-colors flex items-center gap-2")
                                |                 Subscribe Below 
                                |                 
                                svg(width="16", height="16", viewbox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                                    path(d="M12 5v14M5 12l7 7 7-7", stroke-linecap="square", stroke-linejoin="miter")
                    div(class="lg:col-span-5 relative aspect-[4/5] w-full group mt-12 lg:mt-0")
                        div(class="absolute inset-0 bg-zinc-200 translate-x-4 translate-y-4 transition-transform duration-700 group-hover:translate-x-6 group-hover:translate-y-6")
                        div(class="absolute inset-0 overflow-hidden border border-zinc-900/10")
                            img(src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2070&auto=format&fit=crop", alt="Engineers collaborating on hardware", class="w-full h-full object-cover grayscale contrast-125 transition-transform duration-1000 group-hover:scale-105 group-hover:rotate-1")
            section(id="subscribe", class="w-full bg-zinc-950 text-zinc-50 py-32 px-6 md:px-12")
                div(class="max-w-4xl mx-auto flex flex-col items-center text-center")
                    h2(class="font-heading text-3xl sm:text-4xl md:text-6xl font-bold tracking-tighter leading-tight mb-6")
                        |             Discover new tech 
                        br(class="hidden sm:block")
                        | investments first.
                        |           
                    p(class="text-zinc-400 text-base md:text-lg mb-16 max-w-lg")             Sign up for early access to our thesis-driven insights, portfolio updates, and exclusive opportunities.
                    |           
                    form(class="w-full max-w-md flex flex-col gap-8")
                        div(class="relative w-full")
                            input(type="email", placeholder="Email address *", required="", class="w-full bg-transparent border-b border-zinc-700 py-4 px-2 text-zinc-50 placeholder:text-zinc-600 focus:outline-none focus:border-zinc-50 transition-colors peer text-lg")
                        label(class="flex items-start gap-4 cursor-pointer group")
                            div(class="relative flex items-center justify-center w-5 h-5 mt-1 border border-zinc-700 group-hover:border-zinc-50 transition-colors flex-shrink-0")
                                input(type="checkbox", class="peer sr-only", required="")
                                svg(xmlns="http://www.w3.org/2000/svg", class="w-3 h-3 text-zinc-50 opacity-0 peer-checked:opacity-100 transition-opacity", viewbox="0 0 14 10", fill="none")
                                    path(d="M1 5L4.5 8.5L13 1", stroke="currentColor", stroke-width="2", stroke-linecap="square", stroke-linejoin="miter")
                            span(class="text-sm text-zinc-400 group-hover:text-zinc-300 transition-colors text-left leading-relaxed")                 Yes, subscribe me to the newsletter. I agree to receive updates and insights.
                            |               
                        button(type="submit", class="mt-4 w-full bg-zinc-50 text-zinc-950 py-5 font-bold tracking-widest uppercase text-sm hover:bg-zinc-200 transition-colors flex justify-center items-center gap-3 group")
                            span Notify Me
                            svg(class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-2", fill="none", stroke="currentColor", viewbox="0 0 24 24")
                                path(stroke-linecap="square", stroke-linejoin="miter", stroke-width="2", d="M5 12h14M12 5l7 7-7 7")
                div(class="max-w-7xl mx-auto mt-32 pt-8 border-t border-zinc-900 flex flex-col md:flex-row justify-between items-center gap-6 text-xs text-zinc-600 uppercase tracking-widest font-semibold")
                    span © 2026 Twelve Mile Capital
                    div(class="flex gap-8")
                        a(href="#", class="hover:text-zinc-300 transition-colors") Privacy Policy
                        |             
                        a(href="#", class="hover:text-zinc-300 transition-colors") Terms of Service
